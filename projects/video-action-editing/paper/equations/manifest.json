    "label": "eq:controlled-anchor-views"
  },
  {
    "name": "anchor-objective",
    "source": "/paper/source/2_theory.tex",
    "source_sha256": "cea2d74371d5ebc780faf1715c3ed386bbc5263309f84754389b2057df4f35d7",
    "extraction": "equation",
    "selector": "eq:anchor-objective",
    "body": "\\begin{aligned}\n \\mathcal J(E_{\\mathrm a},P)\n ={}&\\lambda\\,\\underbrace{\\E\\|E_{\\mathrm a}(V)-E_{\\mathrm a}(V^+)\\|^2}_{\\mathcal L_{\\mathrm{inv}}}\\\\\n &+\\underbrace{\\E\\|P(E_{\\mathrm a}(V))-\\varphi(V^+)\\|_{\\mathcal H_k}^2}_{\\mathcal L_{\\mathrm{pred}}},\n \\qquad\\lambda>0 .\n \\end{aligned}",
    "inline": false,
    "single_line": false,
    "latex": "/paper/equations/anchor-objective.tex",
    "svg": "/paper/equations/anchor-objective.svg",
    "svg_sha256": "11d777ce785478829a7a7a4b73428b6f3c217d5dda22cd22e7645930283796fa",
    "label": "eq:anchor-objective"
  },
  {
