  {
    "name": "anchor-views",
    "source": "/paper/source/2_theory.tex",
    "source_sha256": "cea2d74371d5ebc780faf1715c3ed386bbc5263309f84754389b2057df4f35d7",
    "extraction": "equation",
    "selector": "eq:controlled-anchor-views",
    "body": "V=g_{\\mathrm{ctrl}}(\\mathbf z^{\\mathrm c},\\mathcal F_T(\\mathbf w)),\\qquad\n V^+=g_{\\mathrm{ctrl}}(\\mathbf z^{\\mathrm c+},\\mathcal F_T(\\mathbf w)).",
