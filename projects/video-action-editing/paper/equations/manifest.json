    "selector": "eq:anchor-identification",
    "body": "E_{\\mathrm a}(V)=h_{\\mathrm a}(\\mathbf z^{\\mathrm a}),\\qquad\n P(h_{\\mathrm a}(\\mathbf z^{\\mathrm a}))=\\mu_k(\\mathbf z^{\\mathrm a})\n \\quad\\text{almost surely},",
    "inline": false,
    "single_line": true,
    "latex": "/paper/equations/anchor-identification.tex",
